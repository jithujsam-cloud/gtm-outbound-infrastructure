# Supabase — create a project at supabase.com, then grab these from Settings → API
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Password for the agency dashboard and API routes (HTTP Basic Auth, any username).
# Required: without it the agency side returns 503. The public /c/[slug] portal is unaffected.
AGENCY_PASSWORD=
