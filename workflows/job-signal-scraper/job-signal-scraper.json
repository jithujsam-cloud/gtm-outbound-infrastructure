    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\n// flatten data safely\nlet data = [];\n\nfor (const item of items) {\n  if (item.json.data && Array.isArray(item.json.data)) {\n    data.push(...item.json.data);\n  } else {\n    data.push(item.json);\n  }\n}\n\nconst grouped = {};\n\nfor (const item of data) {\n  const company = item.companyName || item['Company Name'];\n  let title = item.jobTitle || item['Job Title'];\n  const jd = item.jobDescription || item['Job Description'] || \"\";\n  const location = item.location || item['Location'];\n  const domain = item.companyWebsite || item.domain || \"\";\n  const jobId = item.jobId || item.ID;\n\n  if (!company) continue;\n\n  // normalize title\n  if (title) {\n    title = title.toLowerCase().replace(/\\b\\w/g, c => c.toUpperCase());\n  }\n\n  if (!grouped[company]) {\n    grouped[company] = {\n      jobTitles: new Set(),\n      jobTitleCount: 0,\n      locationCounts: {},\n      locationSet: new Set(),\n      domains: new Set(),\n      jobIds: [],\n      jobDetails: []\n    };\n  }\n\n  // count all jobs\n  if (title) {\n    grouped[company].jobTitleCount += 1;\n    grouped[company].jobTitles.add(title);\n    grouped[company].jobDetails.push(`${title} - ${jd}`);\n  }\n\n  // locations\n  if (location) {\n    grouped[company].locationCounts[location] =\n      (grouped[company].locationCounts[location] || 0) + 1;\n\n    grouped[company].locationSet.add(location);\n  }\n\n  // domains\n  if (domain) grouped[company].domains.add(domain);\n\n  // IDs\n  if (jobId) grouped[company].jobIds.push(jobId);\n}\n\nconst output = [];\n\nfor (const company in grouped) {\n  const jobTitlesArray = Array.from(grouped[company].jobTitles);\n  const domainsArray = Array.from(grouped[company].domains);\n\n  const formattedLocations = Object.entries(grouped[company].locationCounts)\n    .map(([loc, count]) => `${loc} (${count})`)\n    .join(', ');\n\n  const numberedJobDetails = grouped[company].jobDetails\n    .map((item, i) => `${i + 1}. ${item}`)\n    .join('\\n');\n\n  output.push({\n    json: {\n      company,\n\n      job_ids: grouped[company].jobIds,\n\n      job_titles: jobTitlesArray.join(', '),\n      job_title_count: grouped[company].jobTitleCount,\n\n      locations: formattedLocations,\n      location_count: grouped[company].locationSet.size,\n\n      domains: domainsArray.join(', '),\n\n      job_details: numberedJobDetails\n    }\n  });\n}\n\nreturn output;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
